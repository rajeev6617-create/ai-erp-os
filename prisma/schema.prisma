  portalAccount PortalAccount @relation(fields: [portalAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId, portalAccountId])
  @@index([portalAccountId, expiresAt])
  @@map("portal_sessions")
}

model CrmLead {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  leadNumber     String
  companyName    String
  contactName    String?
  email          String?
  phone          String?       @db.VarChar(15)
  source         String
  status         CrmLeadStatus @default(NEW)
  score          Int           @default(0)
  estimatedValue Decimal?      @db.Decimal(18, 2)
  ownerRole      String?
  nextAction     String?
  dueAt          DateTime?
  convertedAt    DateTime?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, leadNumber])
  @@index([organizationId, status, score], map: "crm_leads_org_status_score_idx")
  @@index([customerId])
  @@map("crm_leads")
}

model SalesOpportunity {
  id                String                @id @default(cuid())
  organizationId    String
  customerId        String
  opportunityNumber String
  name              String
  stage             SalesOpportunityStage @default(DISCOVERY)
  amount            Decimal               @db.Decimal(18, 2)
  probability       Int                   @default(0)
  expectedCloseAt   DateTime?
  ownerRole         String?
  metadata          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, opportunityNumber])
  @@index([organizationId, stage, expectedCloseAt], map: "sales_opps_org_stage_close_idx")
  @@index([customerId, stage])
  @@map("sales_opportunities")
}

model VendorOnboarding {
  id               String                 @id @default(cuid())
  organizationId   String
  vendorId         String?
  onboardingNumber String
  supplierName     String
  contactName      String?
  email            String?
  status           VendorOnboardingStatus @default(INVITED)
  riskScore        Int                    @default(0)
  currentStep      String
  submittedAt      DateTime?
  approvedAt       DateTime?
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, onboardingNumber])
  @@index([organizationId, status, riskScore], map: "vendor_onboarding_org_status_risk_idx")
  @@index([vendorId, status])
  @@map("vendor_onboardings")
}

model SupportTicket {
  id             String                @id @default(cuid())
  organizationId String
  customerId     String?
  vendorId       String?
  ticketNumber   String
  subject        String
  description    String?
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  channel        String                @default("PORTAL")
  ownerRole      String?
  dueAt          DateTime?
  resolvedAt     DateTime?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, ticketNumber])
  @@index([organizationId, status, priority], map: "support_tickets_org_status_priority_idx")
  @@index([customerId, status])
  @@index([vendorId, status])
  @@map("support_tickets")
}

model RelationshipAiInsight {
  id             String                @id @default(cuid())
  organizationId String
  module         String
  entityType     String?
  entityId       String?
  title          String
  description    String
  severity       OperationRiskSeverity @default(MEDIUM)
  confidence     Decimal?              @db.Decimal(5, 2)
  status         String                @default("OPEN")
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, module, severity, status], map: "relationship_ai_org_module_severity_idx")
  @@index([organizationId, entityType, entityId], map: "relationship_ai_org_entity_idx")
  @@map("relationship_ai_insights")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  fiscalYearId   String?
  vendorId       String?
  invoiceNumber  String
  invoiceType    String        @default("TAX_INVOICE") // TAX_INVOICE, BILL_OF_SUPPLY, CREDIT_NOTE
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @db.Date
  dueDate        DateTime?     @db.Date

  // Party details (buyer/seller JSON for flexibility)
  sellerDetails Json?
  buyerDetails  Json?
  buyerGstin    String?          @db.VarChar(15)
  placeOfSupply IndianStateCode?

  subtotal       Decimal @db.Decimal(18, 2)
  discountAmount Decimal @default(0) @db.Decimal(18, 2)
  taxableAmount  Decimal @db.Decimal(18, 2)
  cgstAmount     Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal @default(0) @db.Decimal(18, 2)
  cessAmount     Decimal @default(0) @db.Decimal(18, 2)
  tdsAmount      Decimal @default(0) @db.Decimal(18, 2)
  roundOff       Decimal @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal @db.Decimal(18, 2)
  currency       String  @default("INR") @db.Char(3)

  irn       String? // e-Invoice IRN
  ackNumber String?
  ackDate   DateTime?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear?         @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]
  payments     PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, issueDate])
  @@index([vendorId, status])
  @@index([buyerGstin])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String  @id @default(cuid())
  invoiceId    String
  description  String
  hsnSacCode   String?
  quantity     Decimal @db.Decimal(18, 4)
  unit         String?
  unitPrice    Decimal @db.Decimal(18, 2)
  discount     Decimal @default(0) @db.Decimal(18, 2)
  taxableValue Decimal @db.Decimal(18, 2)
  cgstRate     Decimal @default(0) @db.Decimal(5, 2)
  sgstRate     Decimal @default(0) @db.Decimal(5, 2)
  igstRate     Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount   Decimal @default(0) @db.Decimal(18, 2)
  sgstAmount   Decimal @default(0) @db.Decimal(18, 2)
  igstAmount   Decimal @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal @db.Decimal(18, 2)
  metadata     Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  vendorId       String?
  paymentNumber  String
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod
  amount         Decimal       @db.Decimal(18, 2)
  currency       String        @default("INR") @db.Char(3)
  paidAt         DateTime?
  reference      String? // UTR, cheque no, Razorpay payment id
  partyDetails   Json?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  allocations  PaymentAllocation[]

  @@unique([organizationId, paymentNumber])
  @@index([organizationId, status, paidAt])
  @@index([vendorId, status])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  invoiceId String
  amount    Decimal @db.Decimal(18, 2)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@map("payment_allocations")
}

model Expense {
  id             String   @id @default(cuid())
  organizationId String
  vendorId       String?
  expenseNumber  String
  category       String
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @default("INR") @db.Char(3)
  expenseDate    DateTime @db.Date
  employeeId     String?
  description    String?
  receiptDocId   String?
  gstAmount      Decimal  @default(0) @db.Decimal(18, 2)
  tdsAmount      Decimal  @default(0) @db.Decimal(18, 2)
  status         String   @default("DRAFT")
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor       Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, expenseNumber])
  @@index([organizationId, status, expenseDate, deletedAt])
  @@index([vendorId, status])
  @@map("expenses")
}

model Budget {
  id             String  @id @default(cuid())
  organizationId String
  fiscalYearId   String?
  departmentId   String?
  name           String
  category       String
  allocated      Decimal @db.Decimal(18, 2)
  consumed       Decimal @default(0) @db.Decimal(18, 2)
  currency       String  @default("INR") @db.Char(3)
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fiscalYear   FiscalYear?  @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, fiscalYearId])
  @@index([departmentId])
  @@map("budgets")
}

// =============================================================================
// COMPLIANCE
// =============================================================================

model ComplianceFramework {
  id             String  @id @default(cuid())
  organizationId String
  code           String // GST, TDS, PF, ESI, DPDP, ISO27001, SOC2
  name           String
  description    String?
  isActive       Boolean @default(true)
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requirements ComplianceRequirement[]
  assessments  ComplianceAssessment[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("compliance_frameworks")
}

model ComplianceRequirement {
  id          String  @id @default(cuid())
  frameworkId String
  code        String
  title       String
  description String?
  frequency   String? // monthly, quarterly, annual
  dueDay      Int?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  framework   ComplianceFramework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controls    ComplianceControl[]
  assessments ComplianceAssessment[]

  @@unique([frameworkId, code])
  @@map("compliance_requirements")
}

model ComplianceControl {
  id            String  @id @default(cuid())
  requirementId String
  name          String
  controlType   String // preventive, detective, corrective
  automationKey String? // link to workflow/agent
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@map("compliance_controls")
}

model ComplianceAssessment {
  id             String           @id @default(cuid())
  organizationId String
  frameworkId    String
  requirementId  String?
  periodStart    DateTime         @db.Date
  periodEnd      DateTime         @db.Date
  status         ComplianceStatus @default(NOT_STARTED)
  score          Decimal?         @db.Decimal(5, 2)
  assessedById   String?
  assessedAt     DateTime?
  notes          String?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework    ComplianceFramework    @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  requirement  ComplianceRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  evidence     ComplianceEvidence[]

  @@index([organizationId, frameworkId, status])
  @@index([periodStart, periodEnd])
  @@map("compliance_assessments")
}

model ComplianceEvidence {
  id           String   @id @default(cuid())
  assessmentId String
  documentId   String?
  description  String?
  collectedAt  DateTime @default(now())
  metadata     Json?

  assessment ComplianceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  document   Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([assessmentId])
  @@map("compliance_evidence")
}

// =============================================================================
// API KEYS & SECURITY
// =============================================================================

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  keyPrefix      String // first 8 chars for identification
  keyHash        String    @unique
  scopes         String[]
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, keyPrefix])
  @@index([userId])
  @@map("api_keys")
}
