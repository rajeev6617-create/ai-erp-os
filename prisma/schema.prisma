  module       OperationModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  record       OperationRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceKey])
  @@index([organizationId, moduleId, impactType], map: "operation_finance_impacts_organizationId_moduleId_impactType_id")
  @@index([recordId])
  @@map("operation_finance_impacts")
}

model OperationAuditEvent {
  id             String        @id @default(cuid())
  organizationId String
  moduleId       String
  recordId       String?
  sourceKey      String
  action         String
  actor          String?
  severity       AuditSeverity @default(INFO)
