// =============================================================================
// DOCUMENT MANAGEMENT
// =============================================================================

model DocumentFolder {
  id             String  @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  path           String // materialized path for fast tree queries
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     DocumentFolder[] @relation("FolderTree")
  documents    Document[]

  @@unique([organizationId, path])
  @@index([organizationId, parentId, deletedAt])
  @@map("document_folders")
}

model Document {
  id             String             @id @default(cuid())
  organizationId String
  folderId       String?
  departmentId   String?
  createdById    String
  title          String
  description    String?
  fileName       String
  mimeType       String
  sizeBytes      BigInt
  storageKey     String // S3 / blob key
  checksum       String?
  status         DocumentStatus     @default(ACTIVE)
  visibility     DocumentVisibility @default(ORGANIZATION)
  tags           String[]
  retentionUntil DateTime?
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder             DocumentFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  department         Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdBy          User                 @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions           DocumentVersion[]
  shares             DocumentShare[]
  complianceEvidence ComplianceEvidence[]

  @@index([organizationId, status, deletedAt])
  @@index([organizationId, folderId])
  @@index([createdById])
  @@map("documents")
}

model DocumentVersion {
  id          String  @id @default(cuid())
  documentId  String
  version     Int
  storageKey  String
  sizeBytes   BigInt
  checksum    String?
  changeNote  String?
  createdById String?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

model DocumentShare {
  id         String    @id @default(cuid())
  documentId String
  sharedWith String? // userId or email
  permission String    @default("read")
  expiresAt  DateTime?

  createdAt DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_shares")
}

