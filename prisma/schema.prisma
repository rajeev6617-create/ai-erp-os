// AI Enterprise Operating System — Production PostgreSQL Schema
// Multi-tenant · RBAC · Workflows · AI · Finance · Compliance · Audit

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CHURNED
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
  CUSTOM
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
  SERVICE_ACCOUNT
}

enum PermissionScope {
  GLOBAL
  ORGANIZATION
  DEPARTMENT
  SELF
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DEPRECATED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  DELEGATED
  ESCALATED
  EXPIRED
  CANCELLED
}

enum ApprovalType {
  SEQUENTIAL
  PARALLEL
  ANY_ONE
  MAJORITY
  UNANIMOUS
}

enum AiAgentStatus {
  DRAFT
  ACTIVE
  PAUSED
  DEPRECATED
}

enum AiActionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  REQUIRES_APPROVAL
}

enum IntegrationStatus {
  PENDING
  CONNECTED
  ERROR
  DISABLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WEBHOOK
  SLACK
  TEAMS
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum AuditSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum EventDeliveryStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum DocumentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  LEGAL_HOLD
}

enum DocumentVisibility {
  PRIVATE
  DEPARTMENT
  ORGANIZATION
  RESTRICTED
}

enum ComplianceStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLIANT
  NON_COMPLIANT
  EXEMPT
  WAIVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CREDIT_NOTE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  NEFT
  RTGS
  IMPS
  CHEQUE
  CARD
  CASH
  WALLET
  OTHER
}

enum GstRegistrationType {
  REGULAR
  COMPOSITION
  UNREGISTERED
  SEZ
  ISD
}

enum IndianStateCode {
  AN
  AP
  AR
  AS
  BR
  CH
  CT
  DN
  DL
  GA
  GJ
  HP
  HR
  JH
  JK
  KA
  KL
  LA
  LD
  MH
  ML
  MN
  MP
  MZ
  NL
  OR
  PB
  PY
  RJ
  SK
  TN
  TS
  TR
  UK
  UP
  WB
}

enum ActivityType {
  LOGIN
  LOGOUT
  VIEW
  CREATE
  UPDATE
  DELETE
  EXPORT
  IMPORT
  APPROVE
  REJECT
  AI_EXECUTE
  WORKFLOW_START
  WORKFLOW_COMPLETE
  INTEGRATION_SYNC
  OTHER
}

enum OperationModuleCode {
  P2P
  OTC
  R2R
  USER_OPERATIONS
}

enum OperationStageStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_APPROVAL
  BLOCKED
  COMPLETED
}

enum OperationRecordStatus {
  OPEN
  WAITING_APPROVAL
  APPROVED
  BLOCKED
  COMPLETED
  EXCEPTION
}

enum OperationRiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PortalAccountType {
  CUSTOMER
  VENDOR
}

enum PortalAccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CrmLeadStatus {
  NEW
  QUALIFIED
  NURTURING
  CONVERTED
  LOST
}

enum SalesOpportunityStage {
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum VendorOnboardingStatus {
  INVITED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =============================================================================
// TENANT & SAAS
// =============================================================================

model Organization {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  legalName String?
  status    TenantStatus     @default(TRIAL)
  tier      SubscriptionTier @default(FREE)

  // Indian statutory identifiers
  gstin               String?              @db.VarChar(15)
  pan                 String?              @db.VarChar(10)
  tan                 String?              @db.VarChar(10)
  cin                 String?              @db.VarChar(21)
  gstRegistrationType GstRegistrationType?
  stateCode           IndianStateCode?
  registeredAddress   Json?
  billingAddress      Json?

  timezone             String @default("Asia/Kolkata")
  locale               String @default("en-IN")
  currency             String @default("INR") @db.Char(3)
  fiscalYearStartMonth Int    @default(4) // April for India

  settings Json?
  metadata Json?

  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members               OrganizationMember[]
  departments           Department[]
  roles                 Role[]
  workflows             Workflow[]
  workflowExecutions    WorkflowExecution[]
  approvals             Approval[]
  aiAgents              AiAgent[]
  aiActions             AiAction[]
  integrations          Integration[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  activityLogs          ActivityLog[]
  domainEvents          DomainEvent[]
  eventOutbox           EventOutbox[]
  documents             Document[]
  documentFolders       DocumentFolder[]
  complianceFrameworks  ComplianceFramework[]
  ledgerAccounts        LedgerAccount[]
  fiscalYears           FiscalYear[]
  customers             Customer[]
  vendors               Vendor[]
  invoices              Invoice[]
  payments              Payment[]
  expenses              Expense[]
  taxConfigurations     TaxConfiguration[]
  budgets               Budget[]
  approvalChains        ApprovalChain[]
  organizationConfigs   OrganizationConfiguration[]
  workflowConfigurations WorkflowConfiguration[]
  workflowSlaPolicies   WorkflowSlaPolicy[]
  financeRules          FinanceRule[]
  customFieldDefinitions CustomFieldDefinition[]
  employeeProfiles      EmployeeProfile[]
  apiKeys               ApiKey[]
  webhookEndpoints         WebhookEndpoint[]
  sessions                 UserSession[]
  loginAttempts            LoginAttempt[]
  complianceAssessments    ComplianceAssessment[]
  userRoles                UserRole[]
  journalEntries           JournalEntry[]
  notificationPreferences  NotificationPreference[]
  operationModules         OperationModule[]
  operationWorkflowStages  OperationWorkflowStage[]
  operationRecords         OperationRecord[]
  operationApprovalFlows   OperationApprovalFlow[]
  operationRiskAlerts      OperationRiskAlert[]
  operationFinanceImpacts  OperationFinanceImpact[]
  operationAuditEvents     OperationAuditEvent[]
  portalAccounts           PortalAccount[]
  portalSessions           PortalSession[]
  crmLeads                 CrmLead[]
  salesOpportunities       SalesOpportunity[]
  vendorOnboardings        VendorOnboarding[]
  supportTickets           SupportTicket[]
  relationshipAiInsights   RelationshipAiInsight[]

  @@index([status, deletedAt])
  @@index([gstin])
  @@index([pan])
  @@map("organizations")
}

// =============================================================================
// USERS & MEMBERSHIP
// =============================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  phone         String?    @db.VarChar(15)
  phoneVerified DateTime?
  passwordHash  String?
  status        UserStatus @default(INVITED)

  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  locale      String  @default("en-IN")
  timezone    String  @default("Asia/Kolkata")

  mfaEnabled  Boolean   @default(false)
  lastLoginAt DateTime?
  metadata    Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships        OrganizationMember[]
  userRoles          UserRole[]
  employeeProfiles   EmployeeProfile[]
  approvalsRequested Approval[]           @relation("ApprovalRequester")
  approvalSteps      ApprovalStep[]       @relation("ApprovalAssignee")
  auditLogs          AuditLog[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  documentsCreated   Document[]           @relation("DocumentCreator")
  apiKeys                  ApiKey[]
  sessions                 UserSession[]
  mfaFactors               UserMfaFactor[]
  notificationPreferences  NotificationPreference[]

  @@index([status, deletedAt])
  @@index([phone])
  @@map("users")
}

model OrganizationMember {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(MEMBER)
  isPrimary      Boolean    @default(false)
  invitedAt      DateTime?
  joinedAt       DateTime?
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role, deletedAt])
  @@index([userId])
  @@map("organization_members")
}

// =============================================================================
// RBAC & PERMISSIONS
// =============================================================================

model Role {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  isSystem       Boolean @default(false)
  isDefault      Boolean @default(false)
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("roles")
}

model Permission {
  id          String          @id @default(cuid())
  resource    String // e.g. workflow, invoice, document
  action      String // e.g. create, read, update, delete, approve
  scope       PermissionScope @default(ORGANIZATION)
  description String?
  isSystem    Boolean         @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action, scope])
  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  conditions   Json? // ABAC-style conditions

  createdAt DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  departmentId   String? // optional department scope
  grantedById    String?
  expiresAt      DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, roleId, departmentId])
  @@index([organizationId, userId, deletedAt])
  @@index([roleId])
  @@map("user_roles")
}

// =============================================================================
// DEPARTMENTS & EMPLOYEE HIERARCHY
// =============================================================================

model Department {
  id             String  @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  code           String?
  description    String?
  costCenterCode String?
  headEmployeeId String?
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?       @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Department[]      @relation("DepartmentTree")
  employees    EmployeeProfile[]
  userRoles    UserRole[]
  documents    Document[]
  budgets      Budget[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId, deletedAt])
  @@map("departments")
}

model EmployeeProfile {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  departmentId   String?
  employeeCode   String
  designation    String?
  grade          String?
  managerId      String? // reports-to (hierarchy)
  joiningDate    DateTime?
  exitDate       DateTime?
  pan            String?   @db.VarChar(10)
  uan            String?   @db.VarChar(12) // PF UAN
  esiNumber      String?
  bankAccount    Json? // encrypted at app layer
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  manager       EmployeeProfile?  @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports EmployeeProfile[] @relation("EmployeeHierarchy")

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, userId])
  @@index([organizationId, departmentId, deletedAt])
  @@index([managerId])
  @@map("employee_profiles")
}

// =============================================================================
// WORKFLOWS & EXECUTIONS
// =============================================================================

model Workflow {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  version        Int            @default(1)
  status         WorkflowStatus @default(DRAFT)
  triggerType    String // manual, schedule, event, webhook, ai
  triggerConfig  Json?
  definition     Json // DAG / steps schema for AI readiness
  inputSchema    Json?
  outputSchema   Json?
  tags           String[]
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions       WorkflowVersion[]
  executions     WorkflowExecution[]
  approvalChains ApprovalChain[]
  configurations WorkflowConfiguration[]
  slaPolicies    WorkflowSlaPolicy[]

  @@unique([organizationId, slug, version])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, triggerType])
  @@map("workflows")
}

model WorkflowVersion {
  id          String    @id @default(cuid())
  workflowId  String
  version     Int
  definition  Json
  changelog   String?
  publishedAt DateTime?
  publishedBy String?

  createdAt DateTime @default(now())

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id             String          @id @default(cuid())
  organizationId String
  workflowId     String
  correlationId  String? // trace across services
  idempotencyKey String?
  status         ExecutionStatus @default(PENDING)
  priority       Int             @default(0)
  input          Json?
  output         Json?
  context        Json? // runtime variables
  error          Json?
  startedAt      DateTime?
  completedAt    DateTime?
  triggeredBy    String? // userId or system
  triggerSource  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow                @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  steps        WorkflowExecutionStep[]
  approvals    Approval[]
  aiActions    AiAction[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([workflowId, createdAt])
  @@index([correlationId])
  @@map("workflow_executions")
}

model WorkflowExecutionStep {
  id          String          @id @default(cuid())
  executionId String
  stepKey     String
  stepType    String // task, approval, ai, integration, condition
  status      ExecutionStatus @default(PENDING)
  input       Json?
  output      Json?
  error       Json?
  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  execution WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  aiActions AiAction[]

  @@index([executionId, status])
  @@index([executionId, stepKey])
  @@map("workflow_execution_steps")
}

// =============================================================================
// APPROVALS & CHAINS
// =============================================================================

model ApprovalChain {
  id             String       @id @default(cuid())
  organizationId String
  workflowId     String?
  name           String
  slug           String
  approvalType   ApprovalType @default(SEQUENTIAL)
  steps          Json // template step definitions
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflow     Workflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  approvals    Approval[]

  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  @@map("approval_chains")
}

model Approval {
  id             String         @id @default(cuid())
  organizationId String
  chainId        String?
  executionId    String?
  requesterId    String
  title          String
  description    String?
  entityType     String // polymorphic: invoice, expense, workflow_step
  entityId       String
  status         ApprovalStatus @default(PENDING)
  approvalType   ApprovalType   @default(SEQUENTIAL)
  dueAt          DateTime?
  completedAt    DateTime?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chain        ApprovalChain?     @relation(fields: [chainId], references: [id], onDelete: SetNull)
  execution    WorkflowExecution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  requester    User               @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  steps        ApprovalStep[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([requesterId])
  @@index([executionId])
  @@map("approvals")
}

model ApprovalStep {
  id           String         @id @default(cuid())
  approvalId   String
  sequence     Int
  assigneeId   String?
  assigneeRole String? // role slug when assignee is dynamic
  status       ApprovalStatus @default(PENDING)
  comment      String?
  actedAt      DateTime?
  delegatedTo  String?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  assignee User?    @relation("ApprovalAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([approvalId, sequence])
  @@index([assigneeId, status])
  @@map("approval_steps")
}

// =============================================================================
// AI AGENTS & ACTIONS
// =============================================================================

model AiAgent {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  status         AiAgentStatus @default(DRAFT)
  modelProvider  String? // openai, anthropic, azure, local
  modelId        String?
  systemPrompt   String?       @db.Text
  tools          Json? // allowed tools / MCP servers
  guardrails     Json?
  config         Json?
  version        Int           @default(1)
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     AiAgentVersion[]
  actions      AiAction[]

  @@unique([organizationId, slug])
  @@index([organizationId, status, deletedAt])
  @@map("ai_agents")
}

model AiAgentVersion {
  id           String    @id @default(cuid())
  agentId      String
  version      Int
  systemPrompt String?   @db.Text
  tools        Json?
  config       Json?
  publishedAt  DateTime?

  createdAt DateTime @default(now())

  agent AiAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
  @@map("ai_agent_versions")
}

model AiAction {
  id               String         @id @default(cuid())
  organizationId   String
  agentId          String?
  executionId      String?
  stepId           String?
  actionType       String // chat, tool_call, workflow_trigger, document_analyze
  status           AiActionStatus @default(QUEUED)
  input            Json?
  output           Json?
  tokenUsage       Json?
  costInr          Decimal?       @db.Decimal(12, 4)
  latencyMs        Int?
  error            Json?
  requiresApproval Boolean        @default(false)
  approvedAt       DateTime?
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        AiAgent?               @relation(fields: [agentId], references: [id], onDelete: SetNull)
  execution    WorkflowExecution?     @relation(fields: [executionId], references: [id], onDelete: SetNull)
  step         WorkflowExecutionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([agentId, createdAt])
  @@index([executionId])
  @@map("ai_actions")
}

// =============================================================================
// INTEGRATIONS
// =============================================================================

model Integration {
  id             String            @id @default(cuid())
  organizationId String
  provider       String // razorpay, tally, zoho, gst_portal, slack
  name           String
  status         IntegrationStatus @default(PENDING)
  config         Json? // non-secret config
  lastSyncAt     DateTime?
  lastError      Json?
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials  IntegrationCredential[]
  syncLogs     IntegrationSyncLog[]

  @@unique([organizationId, provider, name])
  @@index([organizationId, status, deletedAt])
  @@map("integrations")
}

model IntegrationCredential {
  id            String    @id @default(cuid())
  integrationId String
  keyName       String // api_key, refresh_token, client_secret
  vaultRef      String // reference to secrets manager, never store plaintext
  expiresAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  rotatedAt DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, keyName])
  @@map("integration_credentials")
}

model IntegrationSyncLog {
  id            String    @id @default(cuid())
  integrationId String
  direction     String // inbound, outbound
  entityType    String?
  recordsCount  Int       @default(0)
  status        String
  error         Json?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@map("integration_sync_logs")
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secretVaultRef String
  events         String[]
  isActive       Boolean  @default(true)
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive, deletedAt])
  @@map("webhook_endpoints")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(PENDING)
  title          String
  body           String?
  actionUrl      String?
  entityType     String?
  entityId       String?
  payload        Json?
  sentAt         DateTime?
  readAt         DateTime?
