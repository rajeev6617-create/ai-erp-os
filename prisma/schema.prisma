// =============================================================================
// ENTERPRISE OPERATIONS MODULES
// =============================================================================

model OperationModule {
  id             String              @id @default(cuid())
  organizationId String
  code           OperationModuleCode
  name           String
  description    String?
  ownerRole      String?
  financeCategory String?
  metadata       Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         OperationWorkflowStage[]
  records        OperationRecord[]
  approvalFlows  OperationApprovalFlow[]
  riskAlerts     OperationRiskAlert[]
  financeImpacts OperationFinanceImpact[]
  auditEvents    OperationAuditEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("operation_modules")
}

model OperationWorkflowStage {
  id              String               @id @default(cuid())
  organizationId  String
  moduleId        String
  stageKey        String
  name            String
  description     String?
  sequence        Int
  status          OperationStageStatus @default(NOT_STARTED)
  slaHours        Int?
  automationLevel String?
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       OperationModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  records      OperationRecord[]

  @@unique([moduleId, stageKey])
  @@index([organizationId, moduleId, sequence])
  @@index([organizationId, status])
  @@map("operation_workflow_stages")
}

model OperationRecord {
  id             String                @id @default(cuid())
  organizationId String
  moduleId       String
  stageId        String?
  reference      String
  title          String
  description    String?
  status         OperationRecordStatus @default(OPEN)
  amount         Decimal?              @db.Decimal(18, 2)
  currency       String                @default("INR") @db.Char(3)
  counterparty   String?
  ownerRole      String?
  dueAt          DateTime?
  completedAt    DateTime?
  riskScore      Int                   @default(0)
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module         OperationModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  stage          OperationWorkflowStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  riskAlerts     OperationRiskAlert[]
  financeImpacts OperationFinanceImpact[]
  auditEvents    OperationAuditEvent[]

  @@unique([organizationId, reference])
  @@index([organizationId, moduleId, status, dueAt])
  @@index([stageId, status])
  @@map("operation_records")
}

model OperationApprovalFlow {
  id              String       @id @default(cuid())
  organizationId  String
  moduleId        String
  name            String
  description     String?
  trigger         String
  sequence        Int
  approverRole    String
  approvalType    ApprovalType @default(SEQUENTIAL)
  thresholdAmount Decimal?     @db.Decimal(18, 2)
  isActive        Boolean      @default(true)
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       OperationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, sequence])
  @@unique([moduleId, name])
  @@index([organizationId, moduleId, isActive])
  @@map("operation_approval_flows")
}

model OperationRiskAlert {
  id             String                @id @default(cuid())
  organizationId String
  moduleId       String
  recordId       String?
  sourceKey      String
  title          String
  description    String
  severity       OperationRiskSeverity @default(MEDIUM)
  status         String                @default("OPEN")
  signalType     String
  confidence     Decimal?              @db.Decimal(5, 2)
  detectedAt     DateTime              @default(now())
  resolvedAt     DateTime?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  module       OperationModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  record       OperationRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([organizationId, sourceKey])
  @@index([organizationId, moduleId, severity, status], map: "operation_risk_alerts_organizationId_moduleId_severity_status_i")
  @@index([recordId, status])
  @@map("operation_risk_alerts")
}

model OperationFinanceImpact {
  id             String   @id @default(cuid())
  organizationId String
  moduleId       String
  recordId       String?
  sourceKey      String
  impactType     String
  title          String
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @default("INR") @db.Char(3)
